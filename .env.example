# Cloudflare dashboard → R2 → Manage R2 API Tokens (permesso: Object Read & Write sul bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=heinekenaperitop

# Solo se il bucket è stato creato con giurisdizione UE (indirizzo .eu.r2.cloudflarestorage.com)
R2_JURISDICTION=

# Percorso segreto sotto cui stanno le foto su R2 (vedi README, protezione con password)
R2_PREFIX=
